#!/usr/bin/env python3
"""Find and read Claude Code / Codex CLI session logs.

  agent-log latest claude|codex [--cwd DIR]     print newest session file path
  agent-log latest claude|codex -s SESSION      print the log of the agent running in that Rex pane
  agent-log mark FILE                            print current line count (use before sending)
  agent-log wait claude|codex FILE --from N [--timeout 300]
        block until the turn after line N finishes; print the final assistant reply
  agent-log wait claude|codex FILE --from N -s SESSION [--timeout 300] [--json]
        same as agent-watch: also returns when a prompt waits for a person or the
        agent exits, and prints a status line first (see bin/agent-watch --help)
  agent-log show claude|codex FILE [--last 20]  print readable user/assistant transcript
  agent-log model claude|codex FILE              print the model used by the latest turn

Both tools append JSONL in real time, one whole message per line (no token streaming).
Turn end markers: Claude -> {"type":"system","subtype":"turn_duration"};
Codex -> {"type":"event_msg","payload":{"type":"task_complete"}}.

Without -s, `wait` only sees the log. Claude does not log a pending
AskUserQuestion until it is answered, so a menu on screen looks like a long
turn and `wait` runs into its timeout. Use agent-watch (or pass -s) instead.
"""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from atb import logs
from atb.rex import Rex, RexError, TargetError, resolve


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["latest", "mark", "wait", "show", "model"])
    ap.add_argument("args", nargs="*")
    ap.add_argument("--cwd")
    ap.add_argument("--from", dest="frm", type=int, default=0)
    ap.add_argument("--timeout", type=float, default=300)
    ap.add_argument("--last", type=int, default=20)
    ap.add_argument("-s", "--session", help="Rex session ID or label (latest, wait)")
    ap.add_argument("-b", "--block", help="Rex block ID (latest, wait)")
    ap.add_argument("--json", action="store_true", help="with wait -s: print one JSON object")
    a = ap.parse_args()
    if a.cmd == "latest":
        tool = a.args[0]
        if a.session or a.block:
            from atb.watch import resolve_log
            rex = Rex()
            path, _ = resolve_log(rex, resolve(rex, a.session, a.block, tool), tool)
        else:
            path = logs.latest(tool, a.cwd)
        print(path or "")
        sys.exit(0 if path else 1)
    if a.cmd == "mark":
        print(logs.line_count(a.args[0]))
        return
    tool, path = a.args[0], a.args[1]
    if a.cmd == "model":
        print(logs.model_of(tool, path))
        return
    if a.cmd == "show":
        msgs = [m for m in (logs.text_of(tool, r) for r in logs.rows(path)) if m]
        for role, t in msgs[-a.last:]:
            print(f"[{role}] {t}\n")
        return
    if a.session or a.block:
        from atb.watch import watch
        rex = Rex()
        t = resolve(rex, a.session, a.block, tool)
        r = watch(rex, t, tool, path, a.frm, timeout=a.timeout)
        print(r.to_json() if a.json else r.to_text())
        sys.exit(r.code)
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        new = logs.rows(path, a.frm)
        if any(logs.is_end(tool, r) for r in new):
            print(logs.last_reply(tool, new))
            return
        time.sleep(0.5)
    print(f"timeout after {a.timeout}s; turn not finished (a prompt may be waiting on screen; "
          f"agent-watch / wait -s SESSION detects that)", file=sys.stderr)
    sys.exit(3)


if __name__ == "__main__":
    try:
        main()
    except TargetError as e:
        print(f"agent-log: {e}", file=sys.stderr)
        sys.exit(2)
    except RexError as e:
        print(f"agent-log: {e}", file=sys.stderr)
        sys.exit(1)
