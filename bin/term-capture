#!/bin/bash
# Print a Rex terminal's screen and scrollback. Usage:
#   term-capture [-s SESSION] [-b BLOCK] [-w WINDOW] [--trim] [--unwrap] [--format text|html|vt]
# --trim is on by default; pass --no-trim to keep trailing blank lines.
set -euo pipefail
DIR=$(cd "$(dirname "$0")" && pwd)
SESSION="${ATB_SESSION:-}"
BLOCK=""
WINDOW=""
TRIM=1
UNWRAP=0
FORMAT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s) SESSION=$2; shift 2;;
    -b) BLOCK=$2; shift 2;;
    -w) WINDOW=$2; shift 2;;
    --trim) TRIM=1; shift;;
    --no-trim) TRIM=0; shift;;
    --unwrap) UNWRAP=1; shift;;
    --format) FORMAT=$2; shift 2;;
    -h|--help) sed -n '2,5p' "$0"; exit 0;;
    *) echo "term-capture: unknown argument: $1" >&2; exit 2;;
  esac
done
if [ -z "$SESSION" ] && [ -z "$BLOCK" ]; then
  echo "term-capture: pass -s SESSION (or set ATB_SESSION), or -b BLOCK" >&2
  exit 2
fi
args=()
[ -n "$SESSION" ] && args+=(-s "$SESSION")
[ -n "$BLOCK" ] && args+=(-b "$BLOCK")
[ -n "$WINDOW" ] && args+=(-w "$WINDOW")
[ "$TRIM" = 1 ] && args+=(--trim)
[ "$UNWRAP" = 1 ] && args+=(--unwrap)
[ -n "$FORMAT" ] && args+=(--format "$FORMAT")
exec "$DIR/rex" capture "${args[@]}"
