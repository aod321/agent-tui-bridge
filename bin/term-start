#!/bin/bash
# Open a new terminal tab (Cmd+T) and run a command in it, e.g. claude or codex.
# Usage: term-start [-a APP] "command"
APP="${ATB_TERM:-Rex Beta}"
while getopts "a:" o; do case $o in a) APP=$OPTARG;; esac; done
shift $((OPTIND-1))
open -a "$APP"; sleep 1
osascript -e "tell application \"$APP\" to activate" -e 'delay 0.6' -e 'tell application "System Events" to keystroke "t" using command down' -e 'delay 1.2'
"$(dirname "$0")/term-send" -a "$APP" "$*"
